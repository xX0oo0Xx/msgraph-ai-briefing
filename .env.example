# Copy to .env and fill in. Never commit .env.

# Entra ID app registration -> Overview -> Application (client) ID
MS_CLIENT_ID=
# "consumers" = personal Microsoft accounts (Outlook.com/Hotmail).
# Use "organizations" or a tenant ID for work/school accounts.
MS_AUTHORITY=https://login.microsoftonline.com/consumers

# Anthropic API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# USD per million tokens, used for cost telemetry only. Check current pricing for your model.
LLM_PRICE_IN_PER_MTOK=3.0
LLM_PRICE_OUT_PER_MTOK=15.0

# Where the briefing email is sent. Defaults to the signed-in account.
BRIEFING_RECIPIENT=
# Windows time zone name, used by Graph for calendar times.
OUTLOOK_TIMEZONE=Pacific Standard Time
LOOKBACK_HOURS=24
MAX_EMAILS=25
